# Optional: enables the contact form to actually send email via Resend (https://resend.com).
# Without these set, submissions are only logged server-side and the visitor
# sees a note that delivery isn't configured yet.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@scalwe.com

# Required: SQLite database used by Prisma for user accounts (login/signup).
DATABASE_URL="file:./dev.db"

# Required: secret used to sign session cookies. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
