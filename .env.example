# Optional: enables the contact form to actually send email via Resend (https://resend.com).
# Without these set, submissions are only logged server-side and the visitor
# sees a note that delivery isn't configured yet.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@scalwe.com

# reCAPTCHA v2 ("I'm not a robot" checkbox) — get real keys from
# https://www.google.com/recaptcha/admin for your domain before going live.
# Without these set, the form falls back to Google's shared test key (always
# passes) and server-side verification is skipped.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
